import java.util.Scanner;

public class PasswordStrengthChecker {

    public static void checkPassword(String password) {

        int score = 0;

        boolean hasUppercase = false;
        boolean hasLowercase = false;
        boolean hasNumber = false;
        boolean hasSpecial = false;

        // Check password length
        if (password.length() >= 8) {
            score++;
        }

        // Check each character
        for (int i = 0; i < password.length(); i++) {

            char ch = password.charAt(i);

            if (Character.isUpperCase(ch)) {
                hasUppercase = true;
            }
            else if (Character.isLowerCase(ch)) {
                hasLowercase = true;
            }
            else if (Character.isDigit(ch)) {
                hasNumber = true;
            }
            else {
                hasSpecial = true;
            }
        }

        // Add score
        if (hasUppercase) {
            score++;
        }

        if (hasLowercase) {
            score++;
        }

        if (hasNumber) {
            score++;
        }

        if (hasSpecial) {
            score++;
        }

        // Display password requirements
        System.out.println("\nPassword Analysis");
        System.out.println("--------------------");

        System.out.println("Length >= 8       : " +
                (password.length() >= 8 ? "Yes" : "No"));

        System.out.println("Uppercase Letter  : " +
                (hasUppercase ? "Yes" : "No"));

        System.out.println("Lowercase Letter  : " +
                (hasLowercase ? "Yes" : "No"));

        System.out.println("Number            : " +
                (hasNumber ? "Yes" : "No"));

        System.out.println("Special Character : " +
                (hasSpecial ? "Yes" : "No"));

        System.out.println("Strength Score    : " + score + "/5");

        // Final result
        if (score <= 2) {
            System.out.println("Result            : WEAK PASSWORD");
        }
        else if (score <= 4) {
            System.out.println("Result            : MEDIUM PASSWORD");
        }
        else {
            System.out.println("Result            : STRONG PASSWORD");
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("==================================");
        System.out.println("       PASSWORD STRENGTH CHECKER");
        System.out.println("==================================");

        System.out.print("Enter your password: ");

        String password = sc.nextLine();

        checkPassword(password);

        sc.close();
    }
}
